# Copiá este archivo como .env y completá los valores desde Neon.
# DATABASE_URL debe ser la conexión pooled para la aplicación.
DATABASE_URL="postgresql://usuario:password@host-pooler:5432/estacionamiento?sslmode=require"

# DATABASE_URL_UNPOOLED es la conexión directa para crear migraciones.
DATABASE_URL_UNPOOLED="postgresql://usuario:password@host:5432/estacionamiento?sslmode=require"
